def factorial(n):
    def multiply(x, y):
        return x * y

    result = 1
    
    for i in range(1, n + 1):
        result = multiply(result, i)

    return result

num = int(input("Enter a non-negative integer: "))
if num < 0:
    print("Please enter a non-negative integer.")
else:
    print(f"The factorial of {num} is {factorial(num)}")
